{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		// general
		"rootDir": "Source",
		//"baseUrl": "Source", // (removed in TS 7) replicate with paths below
		"paths": {"*": ["./Source/*"]},
		"resolveJsonModule": true,
		"outDir": "Source_JS",
		"skipLibCheck": true,

		// compilation
		"esModuleInterop": true,
	},
	"include": [
		"Typings/**/*.d.ts",
		"Source/**/*.ts",
		"Source/**/*.tsx",
	],
	"references": [
		// in-repo packages
		{"path": "../js-common"},
		// external packages
		//{"path": "../../node_modules/web-vcore"},
	]
}
