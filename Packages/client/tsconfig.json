{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// general
		"rootDir": "Source",
		//"baseUrl": "Source", // (removed; TS 7 removed baseUrl) probably todo: comment this, to require relative imports, to be consistent with the output-as-esm packages
		"paths": {"*": ["./Source/*"]}, // replicate baseUrl:"Source" (removed in TS 7), so bare imports like "Store", "Utils/..." resolve under Source/
		"resolveJsonModule": true,
		//"noEmit": false,
		"outDir": "Source_JS",

		// compilation
		"esModuleInterop": true,
	},
	//"files": ["Source/Main.ts"],
	"include": [
		"Typings/**/*.d.ts",
		"Source/**/*.ts",
		"Source/**/*.tsx",
		//"Source/**/*.js",
		//"Source/**/*.jsx"
		//"node_modules/web-vcore/Source/**/*.ts",
		//"node_modules/@debate-map/server-link/Source/**/*.ts",
	],
	"references": [
		// in-repo packages
		{"path": "../js-common"},
		{"path": "../web-vcore"},
		// external packages
		//{"path": "../../node_modules/web-vcore"},
	],
}